# API Credentials & Supervised Telegram Pilot (Phase 4G: Two-Recipient Architecture)
GEMINI_API_KEY=your_gemini_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_admin_chat_id                  # Administrator / Technical Owner
TELEGRAM_PRIMARY_EDITOR_CHAT_ID=your_editor_chat_id # Primary Editor (Girlfriend)
TELEGRAM_ALLOWED_CHAT_IDS=your_admin_chat_id,your_editor_chat_id
TELEGRAM_DELIVERY_ENABLED=false
INSTAGRAM_PUBLISHING_ENABLED=false

# Model & Triage Configuration (Recommended active 2026 models: gemini-3.5-flash-lite, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
MIN_SCORE=82
MAX_PER_RUN=3
MAX_AGE_HOURS=16
MAX_CANDIDATES=55

# Persistence & Storage (Turso for GitHub Actions remote persistence; local fallback is SQLite)
SQLITE_DB_PATH=data/radar.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
STATE_PATH=data/state.json

# Quiet Hours (Telegram Alert Suppression)
QUIET_HOURS_ENABLED=false
QUIET_HOURS_START_UTC=21:00
QUIET_HOURS_END_UTC=05:30
QUIET_HOURS_BEHAVIOR=HOLD
MAX_QUIET_HOURS_HOLD_AGE_HOURS=12

# Hybrid Schedule & Digest Delivery (3-hour scan, 6-hour digest default)
NOTIFICATION_STRATEGY=HYBRID
SCAN_INTERVAL_MINUTES=180
DIGEST_INTERVAL_MINUTES=360
BREAKING_ALERT_MIN_SCORE=92
DIGEST_MIN_SCORE=78
TARGET_DAILY_TELEGRAM_MESSAGES=6
MAX_ITEMS_PER_DIGEST=5
CAP_OVERFLOW_BEHAVIOR=DEFER_TO_NEXT_DIGEST

# Low-Cost Architecture, Safety, Budgets & Timeouts (AI evaluation disabled by default until authorized)
AI_EVALUATION_ENABLED=false
MIN_DISCOVERY_PRIORITY_FOR_AI=5.5
AI_BATCH_SIZE=10
MAX_ESTIMATED_RUN_COST_USD=0.05
MAX_MONTHLY_AI_COST_USD=1.20
MAX_MONTHLY_AI_CALLS=300
MAX_SHADOW_EVAL_BUDGET_USD=0.05
USD_TO_TRY_RATE=36.0
MAX_OUTPUT_TOKENS=3200
ENABLE_SEARCH_GROUNDING=false
HTTP_TIMEOUT_SECONDS=18.0
